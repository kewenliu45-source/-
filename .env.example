# excel: 使用页面上传的 Excel
# database: 使用客户数据库
DATA_SOURCE=excel

# 未连接客户 VPN 时可用 mock 验证数据库分析流程
# 可选值：mock / tplus / openapi / chanjet / sqlserver / mysql / postgresql / oracle
DB_TYPE=mock

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ODBC_DRIVER=SQL Server

# 如需直接使用完整 SQLAlchemy URL，可填写 DATABASE_URL，并留空上方拆分配置
DATABASE_URL=

# 畅捷通 T+ OpenAPI
TPLUS_API_BASE_URL=https://api.example.com
TPLUS_AUTH_BASE_URL=https://openapi.chanjet.com
TPLUS_AUTH_MODE=self_built
TPLUS_APP_KEY=YOUR_APP_KEY
TPLUS_APP_SECRET=YOUR_APP_SECRET
APP_SECRET=YOUR_APP_SECRET
CHANJET_MESSAGE_SECRET=
TPLUS_REDIRECT_URI=
TPLUS_CERTIFICATE=
CHANJET_CERTIFICATE=
TPLUS_APP_TICKET=
TPLUS_ORG_ID=1240415177997138
TPLUS_APP_TICKET_MAX_AGE_SECONDS=1500
TPLUS_TOKEN_REFRESH_SKEW_SECONDS=43200
TPLUS_REQUEST_TIMEOUT=20
TPLUS_RETRY_TIMES=3
TPLUS_QUERY_PAGE_SIZE=200
TPLUS_RECENT_SALES_CACHE_TTL_SECONDS=1800
WARNING_WAREHOUSE_CODE=006

# Configure these from the actual API service names enabled for the Chanjet app.
# EXSV0011 means the service name does not match the current app/account.
TPLUS_INVENTORY_QUERY_ENDPOINT=/tplus/api/v2/inventory/Query
TPLUS_CURRENT_STOCK_QUERY_ENDPOINT=/tplus/api/v2/currentStock/Query

# ========== 登录认证 ==========
# ⚠️ 生产环境必须修改 SESSION_SECRET_KEY！
SESSION_SECRET_KEY=dev-secret-key-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
USER_USERNAME=user
USER_PASSWORD=user123
